-- [[ FUNÇÃO DE PONTO DE SPAWN (COM VELOCIDADE ATUALIZADA EM TEMPO REAL) ]]
local function AddSpawnButton(parent, nomeBotao)
    local posY = countMov
    countMov = countMov + 45

    local Row = Instance.new("Frame", parent)
    Row.Size = UDim2.new(0.85, 0, 0, 32)
    Row.Position = UDim2.new(0.075, 0, 0, posY)
    Row.BackgroundTransparency = 1
    Row.BorderSizePixel = 0
    Row.ZIndex = 2

    local b, led = CriarSegmento(Row, nomeBotao, UDim2.new(0.7, -2, 1, 0), UDim2.new(0, 0, 0, 0))
    local bVel, _, _, velLabel = CriarSegmento(Row, "[1]", UDim2.new(0.3, -2, 1, 0), UDim2.new(0.7, 2, 0, 0), true)

    local nivelVoo = 1
    TapOuHold(bVel, TEMPO_HOLD,
        function()
            nivelVoo = nivelVoo + 1
            if nivelVoo > 10 then nivelVoo = 1 end
            velLabel.Text = "[" .. nivelVoo .. "]"
        end,
        function()
            nivelVoo = 1
            velLabel.Text = "[1]"
        end)

    local savedCFrame = nil
    local ultimoClique = 0
    local threadHold = nil
    local segurou = false
    local voandoAgora = false
    local pararVooFuncao = nil

    local function teleportarParaDestino(destinoCFrame)
        if not lp.Character or not lp.Character:FindFirstChild("HumanoidRootPart") then return end
        local hrp = lp.Character.HumanoidRootPart
        local charParts = {}
        for _, part in pairs(lp.Character:GetDescendants()) do
            if part:IsA("BasePart") then table.insert(charParts, part); part.CanCollide = false end
        end
        hrp.Velocity = Vector3.new(0, 0, 0)
        hrp.CFrame = destinoCFrame
        task.wait(0.05)
        hrp.Velocity = Vector3.new(0, 0, 0)
        hrp.CFrame = destinoCFrame
        if not NoClipOn then
            task.wait(0.2)
            for _, part in pairs(charParts) do if part and part.Parent then part.CanCollide = true end end
        end
    end

    local function voarParaDestino(destinoCFrame)
        if voandoAgora then
            if pararVooFuncao then pararVooFuncao() end
            return
        end

        if not lp.Character or not lp.Character:FindFirstChild("HumanoidRootPart") then return end
        voandoAgora = true
        local hrp = lp.Character.HumanoidRootPart

        local charParts = {}
        for _, part in pairs(lp.Character:GetDescendants()) do
            if part:IsA("BasePart") then table.insert(charParts, part); part.CanCollide = false end
        end

        local conexaoVoo
        pararVooFuncao = function()
            if conexaoVoo then conexaoVoo:Disconnect() end
            if hrp and hrp.Parent then hrp.Velocity = Vector3.new(0, 0, 0) end
            if not NoClipOn then
                for _, part in pairs(charParts) do if part and part.Parent then part.CanCollide = true end end
            end
            voandoAgora = false
            pararVooFuncao = nil
        end

        conexaoVoo = RunService.Stepped:Connect(function(_, step)
            local hum = hrp and hrp.Parent and hrp.Parent:FindFirstChildOfClass("Humanoid")
            if not hrp or not hrp.Parent or not hum or hum.Health <= 0 then
                if pararVooFuncao then pararVooFuncao() end
                return
            end

            for _, part in ipairs(charParts) do
                if part.CanCollide then part.CanCollide = false end
            end

            -- LÊ O `nivelVoo` DIRETO A CADA FRAME PARA ATUALIZAR EM TEMPO REAL
            local velocidadeVoo = VEL_PADRAO * nivelVoo
            local direcao = (destinoCFrame.Position - hrp.Position)
            local distancia = direcao.Magnitude
            local limite = math.max(5, velocidadeVoo * (step or 1 / 60) * 1.5)

            if distancia < limite then
                hrp.CFrame = destinoCFrame
                if pararVooFuncao then pararVooFuncao() end
            else
                hrp.Velocity = direcao.Unit * velocidadeVoo
                hrp.CFrame = CFrame.new(hrp.Position, destinoCFrame.Position)
            end
        end)
        Track(conexaoVoo)
    end

    b.MouseButton1Down:Connect(function()
        segurou = false
        if threadHold then task.cancel(threadHold) end
        threadHold = task.spawn(function()
            task.wait(0.8)
            segurou = true
            savedCFrame = nil
            if pararVooFuncao then pararVooFuncao() end
            led.BackgroundColor3 = COR_OFF
        end)
    end)

    b.MouseButton1Up:Connect(function()
        if threadHold then task.cancel(threadHold); threadHold = nil end
        if segurou then return end

        local agora = tick()
        local tempoDecorrido = agora - ultimoClique

        if voandoAgora then
            if pararVooFuncao then pararVooFuncao() end
            ultimoClique = agora
            return
        end

        if tempoDecorrido < 0.46 then
            ultimoClique = 0
            if savedCFrame then teleportarParaDestino(savedCFrame) end
        else
            ultimoClique = agora
            if not savedCFrame then
                if lp.Character and lp.Character:FindFirstChild("HumanoidRootPart") then
                    savedCFrame = lp.Character.HumanoidRootPart.CFrame
                    led.BackgroundColor3 = COR_ON
                end
            else
                task.spawn(function()
                    task.wait(0.46)
                    if (tick() - ultimoClique) >= 0.46 and savedCFrame and not voandoAgora then
                        voarParaDestino(savedCFrame)
                    end
                end)
            end
        end
    end)
end

