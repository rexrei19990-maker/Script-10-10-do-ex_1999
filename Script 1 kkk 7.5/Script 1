-- [[ MONITOR DE DANO ]]
local function EncontrarDestinoSeguro(hrp, distancia, alturaExtra)
    local params = OverlapParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {lp.Character}
    local base = hrp.Position
    local primeiro = nil
    for _ = 1, 8 do
        local ang = math.rad(math.random(0, 360))
        local pos = base + Vector3.new(math.cos(ang) * distancia, alturaExtra, math.sin(ang) * distancia)
        primeiro = primeiro or pos
        local livre = true
        for _, p in ipairs(workspace:GetPartBoundsInRadius(pos, 3, params)) do
            if p.CanCollide then livre = false; break end
        end
        if livre then return pos end
    end
    return primeiro
end

local function ConectarMonitorDano(char)
    if _G.QuantumHealthConnection then _G.QuantumHealthConnection:Disconnect() end
    local hum = char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 5)
    local hrp = char:FindFirstChild("HumanoidRootPart") or char:WaitForChild("HumanoidRootPart", 5)

    if hum and hrp then
        local ultimaVida = hum.Health
        _G.QuantumHealthConnection = hum.HealthChanged:Connect(function(vidaAtual)
            if FugirPerigoOn and vidaAtual < ultimaVida and vidaAtual > 0 then
                hrp.Velocity = Vector3.new(0, 0, 0)
                local distanciaFinal = 15 * NivelFuga
                local destino = EncontrarDestinoSeguro(hrp, distanciaFinal, 5 + (NivelFuga * 1.5))
                local cf = hrp.CFrame
                hrp.CFrame = cf + (destino - cf.Position)
            end
            ultimaVida = vidaAtual
        end)
        Track(_G.QuantumHealthConnection)
    end
end

if lp.Character then task.spawn(ConectarMonitorDano, lp.Character) end
Track(lp.CharacterAdded:Connect(function(newChar)
    CurrentTarget = nil
    task.wait(0.5)
    ConectarMonitorDano(newChar)
end))

-- [[ LOOP PRINCIPAL DE MOVIMENTO & COMBATE ]]
local noclipParts, noclipT, noclipChar = {}, 0, nil

Track(RunService.Stepped:Connect(function()
    local char = lp.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not (hrp and hum) then return end
    if hum.Health <= 0 then return end

    if ModoCriativoOn then
        local bv = hrp:FindFirstChild("QuantumFlyVelocity") or Instance.new("BodyVelocity", hrp)
        bv.Name = "QuantumFlyVelocity"
        bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)

        hrp.AssemblyLinearVelocity = Vector3.new(hrp.AssemblyLinearVelocity.X, 0, hrp.AssemblyLinearVelocity.Z)

        local velVertical = 0
        if SubindoPorBotao then velVertical = ForcaPulo
        elseif DescendoPorBotao then velVertical = -ForcaPulo
        else velVertical = 0 end

        local move = hum.MoveDirection
        local velHoriz = SpeedOn and (move * ForcaVel) or (move * (hum.WalkSpeed > 0 and hum.WalkSpeed or 16))
        bv.Velocity = Vector3.new(velHoriz.X, velVertical, velHoriz.Z)
    else
        local bv = hrp:FindFirstChild("QuantumFlyVelocity")
        if bv then bv:Destroy() end

        if SpeedOn and hum.MoveDirection.Magnitude > 0 then
            hrp.Velocity = Vector3.new(hum.MoveDirection.X * ForcaVel, hrp.Velocity.Y, hum.MoveDirection.Z * ForcaVel)
        end

        if JumpOn and (UserInputService:IsKeyDown(Enum.KeyCode.Space) or hum.Jump or SubindoPorBotao) then
            hrp.Velocity = Vector3.new(hrp.Velocity.X, ForcaPulo, hrp.Velocity.Z)
        end
    end

    if NoClipOn then
        if noclipChar ~= char or tick() - noclipT > 1 then
            noclipParts = {}
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then table.insert(noclipParts, part) end
            end
            noclipT = tick(); noclipChar = char
        end
        for _, part in ipairs(noclipParts) do part.CanCollide = false end
    end

    if LockPlayerOn or LockNpcOn then
        local alvoValido = false
        if CurrentTarget and CurrentTarget:IsDescendantOf(workspace) then
            local th = CurrentTarget.Parent and CurrentTarget.Parent:FindFirstChildOfClass("Humanoid")
            alvoValido = th ~= nil and th.Health > 0
        end

        if not alvoValido then
            CurrentTarget = nil
            CurrentTargetTipo = nil
            if tick() - ultimaBuscaMira >= 0.5 then
                ultimaBuscaMira = tick()
                local t, d, tipo = nil, math.huge, nil

                if LockPlayerOn then
                    for _, p in ipairs(Players:GetPlayers()) do
                        local pc = p.Character
                        local phrp = pc and pc:FindFirstChild("HumanoidRootPart")
                        local phum = pc and pc:FindFirstChildOfClass("Humanoid")
                        if p ~= lp and phrp and phum and phum.Health > 0 then
                            local dist = (hrp.Position - phrp.Position).Magnitude
                            if dist < d then d = dist; t = phrp; tipo = "player" end
                        end
                    end
                end

                if LockNpcOn and not t then
                    for _, v in ipairs(workspace:GetDescendants()) do
                        if v:IsA("Humanoid") and v.Health > 0 then
                            local m = v.Parent
                            local r = m and m:FindFirstChild("HumanoidRootPart")
                            if r and m ~= char and not Players:GetPlayerFromCharacter(m) then
                                local dist = (hrp.Position - r.Position).Magnitude
                                if dist < d then d = dist; t = r; tipo = "npc" end
                            end
                        end
                    end
                end
                CurrentTarget = t
                CurrentTargetTipo = tipo
            end
        end

        if CurrentTarget then
            local targetPos = CurrentTarget.Position
            local lookAtTargetXZ = Vector3.new(targetPos.X, hrp.Position.Y, targetPos.Z)
            if (lookAtTargetXZ - hrp.Position).Magnitude > 0.01 then
                hrp.CFrame = CFrame.new(hrp.Position, lookAtTargetXZ)
            end
        end
    else
        CurrentTarget = nil
        CurrentTargetTipo = nil
    end
end))

RunService:BindToRenderStep("QuantumAimLock", Enum.RenderPriority.Camera.Value + 1, function()
    local alvo = CurrentTarget
    if not alvo or not alvo.Parent or not (LockPlayerOn or LockNpcOn) then return end

    local cam = workspace.CurrentCamera
    local char = lp.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not cam or not hrp then return end

    local targetPos = alvo.Position
    local alvoCam = targetPos
    local inclinar = (CurrentTargetTipo == "player" and MiraPlayerInclinada) or (CurrentTargetTipo == "npc" and MiraNpcInclinada)
    if inclinar then
        local dist = (hrp.Position - targetPos).Magnitude
        alvoCam = Vector3.new(targetPos.X, targetPos.Y - (dist * 0.10), targetPos.Z)
    end

    local camPos = cam.CFrame.Position
    if (alvoCam - camPos).Magnitude > 0.01 then
        cam.CFrame = CFrame.lookAt(camPos, alvoCam)
    end
end)

