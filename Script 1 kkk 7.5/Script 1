-- [[ ELIMINAR TUDO ]]
local NivelElim = 1
local NIVEL_CLASSE = {
    ParticleEmitter = 1, Trail = 1, Beam = 1, Smoke = 1, Fire = 1, Sparkles = 1, Explosion = 1,
    PointLight = 1, SpotLight = 1, SurfaceLight = 1,
    Texture = 2, SurfaceAppearance = 2, Animator = 2,
    Decal = 3, ImageLabel = 3, ImageButton = 3, Sound = 3, Highlight = 3,
    Atmosphere = 3, Sky = 3, Clouds = 3, Shirt = 3, Pants = 3, ShirtGraphic = 3, CharacterMesh = 3,
}

local ElimOriginais = setmetatable({}, {__mode = "k"})
local ElimRemovidos = {}
local ElimLighting = nil
local ElimTerrainDeco = nil
local ElimOcupado = false

local function NivelDe(v)
    local n = NIVEL_CLASSE[v.ClassName]
    if n then return n end
    if v:IsA("PostEffect") then return 1 end
    return nil
end

local function AplicarPropsParte(part, o, nivel)
    part.CastShadow = (nivel >= 1) and false or o[2]
    if nivel >= 2 then
        part.Material = Enum.Material.SmoothPlastic
        part.Reflectance = 0
        if o[4] ~= nil then part.TextureID = "" end
    else
        if part.Material ~= o[1] then part.Material = o[1] end
        if part.Reflectance ~= o[3] then part.Reflectance = o[3] end
        if o[4] ~= nil and part.TextureID ~= o[4] then part.TextureID = o[4] end
    end
end

local function ProcessarInstancia(v, guardar)
    local nv = NivelDe(v)
    if nv then
        if nv <= NivelElim then
            if v.ClassName == "Animator" and lp.Character and v:IsDescendantOf(lp.Character) then return end
            if guardar then
                table.insert(ElimRemovidos, {v, v.Parent, nv})
                v.Parent = nil
            else
                v:Destroy()
            end
        end
    elseif v:IsA("BasePart") and not v:IsA("Terrain") then
        local o = ElimOriginais[v]
        if not o then
            o = {v.Material, v.CastShadow, v.Reflectance, v:IsA("MeshPart") and v.TextureID or nil}
            ElimOriginais[v] = o
        end
        AplicarPropsParte(v, o, NivelElim)
    end
end

local function Varrer(lista)
    for i, v in ipairs(lista) do
        if not EliminarTudoOn then return end
        pcall(ProcessarInstancia, v, true)
        if i % 400 == 0 then task.wait() end
    end
end

local function EliminarTudoAgora()
    ElimOcupado = true
    task.spawn(function()
        pcall(function()
            if not ElimLighting then
                ElimLighting = {GlobalShadows = Lighting.GlobalShadows, FogEnd = Lighting.FogEnd}
            end
            Lighting.GlobalShadows = false
            Lighting.FogEnd = 9e9
        end)
        pcall(function()
            local t = workspace.Terrain
            if ElimTerrainDeco == nil then ElimTerrainDeco = t.Decoration end
            t.Decoration = false
        end)
        Varrer(Lighting:GetChildren())
        Varrer(workspace:GetDescendants())
        ElimOcupado = false
    end)
end

local function RestaurarTudo(nivelAlvo)
    task.spawn(function()
        while ElimOcupado do task.wait() end
        ElimOcupado = true

        local lista = ElimRemovidos
        local manter = {}
        ElimRemovidos = manter
        for i = #lista, 1, -1 do
            local item = lista[i]
            if item[3] > nivelAlvo then
                pcall(function()
                    if item[2] and item[2]:IsDescendantOf(game) then item[1].Parent = item[2] end
                end)
            else
                manter[#manter + 1] = item
            end
            if i % 400 == 0 then task.wait() end
        end

        local partes = {}
        for part, o in pairs(ElimOriginais) do partes[#partes + 1] = {part, o} end
        if nivelAlvo == 0 then ElimOriginais = setmetatable({}, {__mode = "k"}) end
        for i, item in ipairs(partes) do
            pcall(AplicarPropsParte, item[1], item[2], nivelAlvo)
            if i % 400 == 0 then task.wait() end
        end

        if nivelAlvo == 0 then
            pcall(function()
                if ElimLighting then
                    Lighting.GlobalShadows = ElimLighting.GlobalShadows
                    Lighting.FogEnd = ElimLighting.FogEnd
                    ElimLighting = nil
                end
            end)
            pcall(function()
                if ElimTerrainDeco ~= nil then
                    workspace.Terrain.Decoration = ElimTerrainDeco
                    ElimTerrainDeco = nil
                end
            end)
        end
        ElimOcupado = false
    end)
end

local function MudarNivelElim(novo)
    local antigo = NivelElim
    NivelElim = novo
    if not EliminarTudoOn then return end
    if novo > antigo then EliminarTudoAgora() else RestaurarTudo(novo) end
end

_G.QuantumRestaurar = function()
    EliminarTudoOn = false
    RestaurarTudo(0)
end

local function AoAdicionar(v)
    if EliminarTudoOn then
        task.defer(function() pcall(ProcessarInstancia, v, v.ClassName == "Animator") end)
    end
end
