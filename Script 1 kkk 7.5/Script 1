local function PuloPadrao(h)
    if not h then return 50 end
    if h.UseJumpPower then return math.max(1, math.floor(h.JumpPower)) end
    return math.max(1, math.floor(math.sqrt(2 * workspace.Gravity * h.JumpHeight)))
end

