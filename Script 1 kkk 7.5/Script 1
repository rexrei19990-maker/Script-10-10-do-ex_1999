-- FUNÇÃO ARRASTAR NORMAL (PAINEL E BOLINHA)
local function MakeDraggable(frame)
    local dragging, dragInput, dragStart, startPos
    frame.InputBegan:Connect(function(input)
        if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
            dragging = true; dragStart = input.Position; startPos = frame.Position
        end
    end)
    frame.InputChanged:Connect(function(input)
        if (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then dragInput = input end
    end)
    Track(UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end))
    Track(UserInputService.InputEnded:Connect(function(input)
        if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then dragging = false end
    end))
end

-- FUNÇÃO ARRASTAR COM HOLD DE 1 SEGUNDO (BOTÕES FLUTUANTES)
local function MakeDraggableWithHold(frame)
    local dragging, dragInput, dragStart, startPos = false, nil, nil, nil
    local holdTimer = nil
    local isHolding = false

    frame.InputBegan:Connect(function(input)
        if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
            isHolding = true
            local startTime = tick()
            if holdTimer then task.cancel(holdTimer) end
            holdTimer = task.spawn(function()
                while isHolding do
                    if tick() - startTime >= 1.0 then
                        dragging = true
                        dragStart = input.Position
                        startPos = frame.Position
                        break
                    end
                    task.wait(0.02)
                end
            end)
        end
    end)

    frame.InputChanged:Connect(function(input)
        if (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            dragInput = input
        end
    end)

    Track(UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end))

    frame.InputEnded:Connect(function(input)
        if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
            isHolding = false
            dragging = false
            if holdTimer then task.cancel(holdTimer); holdTimer = nil end
        end
    end)
end

-- TOQUE CURTO x SEGURAR (ignora se o dedo arrastou, ex: rolando a lista)
local function TapOuHold(btn, tempo, onTap, onHold)
    local ativo, segurou, inicio = nil, false, Vector3.zero
    btn.InputBegan:Connect(function(input)
        if (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1) and not ativo then
            ativo = input; segurou = false; inicio = input.Position
            task.delay(tempo, function()
                if ativo == input and not segurou and (input.Position - inicio).Magnitude < 15 then
                    segurou = true
                    onHold()
                end
            end)
        end
    end)
    btn.InputEnded:Connect(function(input)
        if input == ativo then
            local moveu = (input.Position - inicio).Magnitude >= 15
            ativo = nil
            if not segurou and not moveu then onTap() end
            segurou = false
        end
    end)
end

