local function HandleSlider(sensor, visual, base, lab, prefix, max, state, inicial)
    local p0 = math.clamp(inicial / max, 0, 1)
    sensor.Position = UDim2.new(p0, -20, 0.5, -20); visual.Position = UDim2.new(p0, -10, 0.5, -10); lab.Text = prefix .. inicial

    sensor.InputBegan:Connect(function(i) if (i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1) and not state.activeInput then state.activeInput = i end end)
    Track(UserInputService.InputEnded:Connect(function(i) if i == state.activeInput then state.activeInput = nil end end))
    Track(RunService.RenderStepped:Connect(function()
        if state.activeInput then
            local p = math.clamp((state.activeInput.Position.X - base.AbsolutePosition.X) / base.AbsoluteSize.X, 0, 1)
            sensor.Position = UDim2.new(p, -20, 0.5, -20); visual.Position = UDim2.new(p, -10, 0.5, -10); lab.Text = prefix .. math.floor(p * max)
            if prefix == "Velocidade: " then ForcaVel = math.floor(p * max) else ForcaPulo = math.floor(p * max) end
        end
    end))
end
